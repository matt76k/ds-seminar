pe":"listItem","spread":true,"position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"SNS上での企業や製品の評判監視","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"Hn4K9MpMJb"}],"key":"RAH9rmDgbP"}],"key":"POiTr7lDvJ"},{"type":"listItem","spread":true,"position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"カスタマーサポートの自動化","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"Ji70b6sNgy"}],"key":"DwsRHoDlav"}],"key":"XHrx1vhPHa"},{"type":"listItem","spread":true,"position":{"start":{"line":147,"column":1},"end":{"line":148,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"マーケティング戦略の立案","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"key":"jKbOZu1kW8"}],"key":"L6HgX63utX"}],"key":"jzzHchIVhq"}],"key":"FL0ffwqG6Q"},{"type":"paragraph","position":{"start":{"line":149,"column":1},"end":{"line":151,"column":1}},"children":[{"type":"text","value":"ここでは最もシンプルな感情分析を実装してみましょう。\nその方法とは文章を単語に分割し、文章中にあるポジティブな単語とネガティブな単語の出現回数から\nその文章のポジティブ度とネガティブ度を計算するというものです。","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"CzSaVtIbZS"}],"key":"ufoOiydGSw"}],"key":"OPRhdvdsor"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\nfrom sudachipy import tokenizer, dictionary\nfrom tabulate import tabulate \n\ndef tokenize(text):\n    tokenizer_obj = dictionary.Dictionary().tokenizer()\n    mode = tokenizer.Tokenizer.SplitMode.C\n    morphemes = tokenizer_obj.tokenize(text, mode)\n    tokens = [m.dictionary_form() for m in morphemes]\n    return tokens\n\n# サンプルテキスト\ntexts = [\n    \"このレストランの料理はとても美味しかった。また行きたい。\",\n    \"サービスが遅く、値段も高すぎる。二度と利用しない。\",\n    \"製品の品質は普通だが、配送が早くて助かった。\"\n]\n\n# ポジティブな単語とネガティブな単語のリスト\npositive_words = [\"美味しい\", \"良い\", \"素晴らしい\", \"助かる\", \"早い\"]\nnegative_words = [\"遅い\", \"高い\", \"悪い\", \"ひどい\"]\n\nresults = []\nfor text in texts:\n    tokens = tokenize(text)\n\n    total_tokens = len(tokens)\n    \n    pos_matches = [word for word in tokens if word in positive_words]\n    neg_matches = [word for word in tokens if word in negative_words]\n\n    pos_score = len(pos_matches) / total_tokens if total_tokens > 0 else 0\n    neg_score = len(neg_matches) / total_tokens if total_tokens > 0 else 0\n        \n    compound = pos_score - neg_score\n    \n    results.append({\n        'テキスト': text,\n        'ポジティブ': pos_score,\n        'ネガティブ': neg_score,\n        '複合スコア': compound\n    })\n\ndf = pd.DataFrame(results)\nprint(tabulate(df, headers='keys', tablefmt='plain', showindex=False))","key":"kgUEgVvOXt"},{"type":"outputs","id":"qF6Cb6zwuJGkBMTUckKXi","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"テキスト                                                    ポジティブ    ネガティブ    複合スコア\nこのレストランの料理はとても美味しかった。また行きたい。     0.0769231         0         0.0769231\nサービスが遅く、値段も高すぎる。二度と利用しない。           0                 0.125    -0.125\n製品の品質は普通だが、配送が早くて助かった。                 0.133333          0         0.133333\n"},"key":"qXdg7RTJPK"}],"key":"JWlJ1qXl8B"}],"key":"c3XgO7Ptfl"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":201,"column":1},"end":{"line":201,"column":1}},"children":[{"type":"text","value":"このコードは基本的ですが、以下のように発展できます。","position":{"start":{"line":201,"column":1},"end":{"line":201,"column":1}},"key":"w4K6PKMnQ7"}],"key":"U1OVSZjexM"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":203,"column":1},"end":{"line":206,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":203,"column":1},"end":{"line":203,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"より豊富な感情辞書の使用","position":{"start":{"li