0,"column":1}},"key":"ESciFZbVFU"}],"identifier":"wordcloud","label":"WordCloud","html_id":"wordcloud","implicit":true,"enumerator":"11.5","key":"dd76aDBNZY"},{"type":"paragraph","position":{"start":{"line":242,"column":1},"end":{"line":243,"column":1}},"children":[{"type":"text","value":"WordCloud（","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"RSH5jiVRVz"},{"type":"span","children":[{"type":"text","value":"ワードクラウド","key":"AYg7Mk7u1f"}],"indexEntries":[{"entry":"ワードクラウド","emphasis":false}],"label":"index-ImqZzighbr","identifier":"index-imqzzighbr","html_id":"index-imqzzighbr","key":"POwMFSfLKs"},{"type":"text","value":"）とは、文書内の単語の出現頻度を視覚的に表現するための手法です。\n頻出単語ほど大きなフォントで表示されるため、文章の中でどのような単語が重要かを一目で把握できます。","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"PY96oqh86S"}],"key":"jldw7sPk1u"},{"type":"paragraph","position":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}},"children":[{"type":"text","value":"Webサイトから情報を取得し、そこに含まれる名詞をWordCloudで可視化してみましょう。","position":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}},"key":"arVdgAwSoo"}],"key":"af1NoVnUfe"}],"key":"qJeetpgOtS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport matplotlib.font_manager as fm\nfrom sudachipy import tokenizer, dictionary\n\nfrom wordcloud import WordCloud\nfrom collections import Counter\nimport re\nfrom bs4 import BeautifulSoup\nimport requests\n\nurl = \"https://www.soi.kumamoto-u.ac.jp/\"\nresponse = requests.get(url)\nresponse.encoding = response.apparent_encoding\n\nsoup = BeautifulSoup(response.text, features=\"html.parser\")\n\ntext = soup.get_text()\n\n# Sudachiの設定\ntokenizer_obj = dictionary.Dictionary().tokenizer()\nmode = tokenizer.Tokenizer.SplitMode.C\n\n# 単語の抽出\nwords = []\nfor line in text.split('\\n'):\n    tokens = tokenizer_obj.tokenize(line, mode)\n    for token in tokens:\n        # 名詞のみを抽出\n        pos = token.part_of_speech()[0]\n        if pos in [\"名詞\"]:\n            word = token.normalized_form()\n            # 1文字の単語、数字のみの単語を除外\n            if len(word) > 1 and not re.match(r'^[0-9]+$', word):\n                words.append(word)\n\n# 出現頻度の集計\nword_count = Counter(words)\n\n# システムにインストールされている日本語フォントを自動検出\nfonts = [f.name for f in fm.fontManager.ttflist if 'Gothic' in f.name or 'Mincho' in f.name or '明朝' in f.name or 'ゴシック' in f.name]\nfont_path = fm.findfont(fonts[0] if fonts else 'DejaVu Sans')\n\nwordcloud = WordCloud(\n    background_color='white',\n    font_path=font_path,\n    width=800,\n    height=600,\n    max_words=100,\n    colormap='viridis'\n)\nwordcloud.generate_from_frequencies(word_count)\n\nplt.figure(figsize=(10, 8))\nplt.imshow(wordcloud, interpolation='bilinear')\nplt.axis('off')\nplt.tight_layout()\nplt.show()","showLineNumbers":true,"key":"c8ybph4qmZ"},{"type":"outputs","id":"gJ71TaNDH2qsukiBHpu69","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x800 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"a417dabda268fe5e9ed2ea8b78b37224","path":"/ds-seminar/_public/a417dabda268fe5e9ed2ea8b78b37224.png"}}},"key":"esSLVllgZt"}],"key":"C81rMoSAbp"}],"key":"rTYLU2pLLx"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":308,"column":1},"end":{"line":310,"column":1}},"children":[{"type":"text","value":"プログラムの説明をします。\n5-9行目は\nウェブサイトからテキストを取得し、単語を抽出して、その出現頻度を視覚的に表示するという一連の処理を行うために必要なライブラリを読み込んでいます。","position":{"start":{"line":308,"column":1},"end":{"line":308,"column":1}},"key":"QUSuzf8Ypf"}],"key":"aRZKd7P38d"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":312,"column":1},"end":{"line":322,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":312,"column":1},"end":{"line":313,"column":1}},"children":[{"t