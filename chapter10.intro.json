-SNEを適用し、2次元に削減します。","position":{"start":{"line":268,"column":1},"end":{"line":268,"column":1}},"key":"IQjfId9apl"}],"key":"fRVN4IR6uq"}],"key":"uyHaw6OufF"}],"key":"q65dX6Y2QT"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"サポートベクトルマシン","url":"/chapter09/intro","group":"Pythonで学ぶ！データサイエンス講座"},"next":{"title":"テキストデータの分析","url":"/chapter11/intro","group":"Pythonで学ぶ！データサイエンス講座"}}},"domain":"http://pre.render"}